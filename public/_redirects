# Production redirects for the static export.
#
# `next.config.mjs` redirects() is unsupported in `output: 'export'`; Workers
# Static Assets applies this file natively instead, without invoking the Worker.
# Keep in sync with serverOnlyConfig in next.config.mjs.
#
# These are legacy sitemap URLs that search engines still request from an older
# multi-sitemap layout. 301 so they stop being crawled.

/sitemap-movies.xml      /sitemap.xml  301
/sitemap-tv-shows.xml    /sitemap.xml  301
/sitemap-trending.xml    /sitemap.xml  301
/sitemap-static.xml      /sitemap.xml  301
/server-sitemap-index.xml /sitemap.xml 301

# The manifest's real name is /site.webmanifest. Audit tools and some crawlers
# probe the conventional names first and log a 404 against the site.
/manifest.webmanifest    /site.webmanifest 301
/manifest.json           /site.webmanifest 301

# Crawlers and link previewers guess these before reading the page's <link>.
/favicon.png             /favicon.ico 301
/icon/favicon.ico        /favicon.ico 301
/img/favicon.ico         /favicon.ico 301

# A trailing slash would otherwise get Cloudflare's default 307 to the slashless
# page: a TEMPORARY redirect, so a link posted with a slash never hands its
# signal to the canonical URL. One rule per path depth (a placeholder matches
# exactly one segment; `/` matches none). The deepest route is
# /movies/genre/<slug> — tests/trailing-slash-redirects.test.ts fails if a
# deeper one appears without a rule.
/:a/ /:a 301
/:a/:b/ /:a/:b 301
/:a/:b/:c/ /:a/:b/:c 301
/:a/:b/:c/:d/ /:a/:b/:c/:d 301

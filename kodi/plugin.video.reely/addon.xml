<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.reely" name="Reely" version="0.1.0" provider-name="Reely">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="plugin.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Reely on your TV</summary>
    <description lang="en_GB">Browse and play Reely with the Reely Player. Needs a Reely supporter account: link it from your phone at reely.space/link.</description>
    <platform>all</platform>
    <website>https://www.reely.space</website>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>

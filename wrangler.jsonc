{
  "account_id": "90d6fc64545d1c449331032979dcbfb5",
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "movies-streaming-platform",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "preview_urls": false,
  // Never expose movies-streaming-platform.<subdomain>.workers.dev. It would
  // serve the whole site on a second, crawlable hostname (duplicate content vs
  // www.reely.space) and it bypasses every WAF / cache / redirect rule, which
  // are all bound to the reely.space zone.
  "workers_dev": false,
  // "placement": {
  // 	"mode": "smart",
  // },
  "routes": [
    {
      "pattern": "reely.space",
      "zone_name": "reely.space",
      "custom_domain": true,
    },
    {
      "pattern": "www.reely.space",
      "zone_name": "reely.space",
      "custom_domain": true,
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "movies-streaming-platform",
    },
  ],
  // Preserve vars configured in the Cloudflare Dashboard on deploy
  "keep_vars": true,
  "vars": {
    "ENVIRONMENT": "production",
    "NODE_ENV": "production",
  },
  // Incremental cache store for OpenNext. KV errors (free-plan 1k writes/day,
  // 100k reads/day) are swallowed by the override and by scripts/cf-deploy.mjs,
  // so hitting a limit degrades to live rendering / stale content — never a
  // crash or a failed deploy. See open-next.config.ts.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "cd422b9f51424c32b976ee260b967be3",
    },
  ],
}

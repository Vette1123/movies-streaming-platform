# ─────────────────────────────────────────────────────────────────────────────
# TMDB (required) — the movie/TV data source
# ─────────────────────────────────────────────────────────────────────────────
TMDB_API_KEY=                        # v3 API key (query-param auth)
TMDB_HEADER_KEY=                     # v4 read access token (Bearer header auth)
NEXT_PUBLIC_TMDB_BASEURL=            # e.g. https://api.themoviedb.org/3/

# ─────────────────────────────────────────────────────────────────────────────
# App URLs (required)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=                # this site's origin, e.g. https://www.reely.space
NEXT_PUBLIC_STREAMING_MOVIES_API_URL= # upstream streaming/player API base
# Backup embed servers, tried in order when the one above will not play. Optional
# — with neither set the site has one server and the switcher hides itself. Not
# checked in anywhere: this repo is public, and the host list is deployment
# configuration, not source. Screen a candidate with `pnpm embed:probe` first.
NEXT_PUBLIC_STREAM_SOURCE_2=         # e.g. https://provider.example/embed
NEXT_PUBLIC_STREAM_SOURCE_3=
# Slots 4/5: same shape, plus PATH TEMPLATES for providers whose URLs differ
# from the vidsrc family (/movie/{id}, /tv/{id}/{s}/{e}). {id}/{s}/{e} fill in.
# NEXT_PUBLIC_STREAM_SOURCE_4=https://host.example
# NEXT_PUBLIC_STREAM_SOURCE_4_MOVIE_PATH=/embed/{id}
# NEXT_PUBLIC_STREAM_SOURCE_4_TV_PATH=/embedtv/{id}?s={s}&e={e}
# Switcher labels (default "Server N") and which SLOT is the public default:
NEXT_PUBLIC_STREAMING_MOVIES_API_LABEL=
NEXT_PUBLIC_STREAM_SOURCE_2_LABEL=
NEXT_PUBLIC_STREAM_SOURCE_3_LABEL=
NEXT_PUBLIC_STREAM_DEFAULT_SLOT=     # default `2`
# Supporters get OUR OWN player as their automatic default (no toggle; free
# accounts switch between the embeds; anonymous visitors get the default only).
# Needs the playback worker AND a gado-proxy tier (reely-resolver-relay repo).
NEXT_PUBLIC_PRO_TRIAL_SELFHOST=      # `true` to enable
# Optional per-slot query appended to every playback URL of that slot — how a
# slot carries player customisation (brand colors, autoplay) for providers that
# accept it. Empty by default: never append junk to a provider whose URLs are
# signed. Example: NEXT_PUBLIC_STREAM_SOURCE_2_QUERY=primaryColor=63b8bc
NEXT_PUBLIC_STREAMING_MOVIES_API_QUERY=
NEXT_PUBLIC_STREAM_SOURCE_2_QUERY=
NEXT_PUBLIC_STREAM_SOURCE_3_QUERY=

# ─────────────────────────────────────────────────────────────────────────────
# Reely Player (our own playback worker, deployed from the private
# reely-pro-player repo)
# ─────────────────────────────────────────────────────────────────────────────
# Public URL of the playback worker. The main worker mints a short-lived entry
# ticket (PLAYBACK_TICKET_SECRET below must match the player's TICKET_SECRET)
# and the browser exchanges it there for a play token. Unset = /api/pro/ticket
# answers 501 and the source switcher falls back to the embed servers.
NEXT_PUBLIC_PLAYBACK_WORKER_URL=
# Shared HMAC secret with the player worker (set there as TICKET_SECRET).
PLAYBACK_TICKET_SECRET=
# External subtitles (Arabic + 10 more languages) need NO key: the PLAYER
# worker walks SubDL's public website and caches the converted VTT per
# title+language for a day. Nothing subtitle-related lives in this repo.

NEXT_PUBLIC_IMAGE_CACHE_HOST_URL=    # image proxy/cache host (e.g. wsrv.nl)
NEXT_PUBLIC_SEARCH_ACTOR_GOOGLE=     # base URL used to build actor Google-search links

# ─────────────────────────────────────────────────────────────────────────────
# Feature flags
# ─────────────────────────────────────────────────────────────────────────────
# IMDb ratings on cards/lists. OFF by default — set to `true` to enable.
# WARNING: on the Cloudflare free plan this fans out one TMDB external_ids
# subrequest per list item and blows the 50-subrequests/invocation cap on any
# LIVE-rendered page (homepage 500 / Error 1102). Only enable on Workers Paid, or
# after precomputing a tmdb_id→rating map read via the ASSETS binding.
NEXT_PUBLIC_IMDB_RATINGS=            # `true` to enable; anything else = off

# ─────────────────────────────────────────────────────────────────────────────
# Analytics (optional — features degrade gracefully if unset)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=             # PostHog project API key
NEXT_PUBLIC_POSTHOG_HOST=            # PostHog host, e.g. https://eu.i.posthog.com
# Source-map upload (build-time only — used by withPostHogConfig in next.config.mjs
# so minified production stack traces symbolicate to real file:line). All three
# are optional: without POSTHOG_API_KEY the build skips upload and proceeds.
POSTHOG_API_KEY=                     # PERSONAL API key w/ scopes: error_tracking:write + organization:read
POSTHOG_PROJECT_ID=                  # numeric project id (e.g. 216915) — from Project settings
POSTHOG_API_HOST=                    # PostHog APP host for upload, e.g. https://eu.posthog.com (NOT the ingestion host above)
NEXT_PUBLIC_APP_VERSION=             # stamped on analytics events; defaults to "dev" if unset

# ─────────────────────────────────────────────────────────────────────────────
# SEO site verification (optional — only needed to claim the site in each console)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION= # Google Search Console verification token
NEXT_PUBLIC_YANDEX_VERIFICATION=      # Yandex Webmaster verification token
NEXT_PUBLIC_BING_VERIFICATION=        # Bing Webmaster (msvalidate.01) token

# ─────────────────────────────────────────────────────────────────────────────
# Accounts, support and alerts (optional — the whole site works without them)
# ─────────────────────────────────────────────────────────────────────────────
# Only NEXT_PUBLIC_* belong here: everything else is a SECRET the Worker reads,
# and lives in `.env.local` locally / `wrangler secret put` in production. With no
# D1 binding the account endpoints answer 503 and the site behaves exactly as it
# did before accounts existed.
#
# These used to live in a separate `.dev.vars`. They were merged into `.env.local`
# on 2026-08-16 — wrangler reads `.env` / `.env.local` by default, but ONLY when no
# `.dev.vars` exists (getVarsForDev in wrangler's cli). Two files meant one of them
# was always dead; do not reintroduce `.dev.vars`.
#
#   Worker secrets (in .env.local, alongside the vars above):
#     SESSION_TOKEN_SECRET   32+ random chars; signs the 15-minute access token
#     GOOGLE_CLIENT_ID       Google Cloud → Credentials → OAuth 2.0 Client ID (Web)
#     GOOGLE_CLIENT_SECRET   the same client's secret
#     BMC_WEBHOOK_SECRET     Buy Me a Coffee → Settings → Webhooks
#     VAPID_PUBLIC_KEY       uncompressed P-256 point, base64url (65 bytes)
#     VAPID_PRIVATE_KEY      the JWK `d` scalar, base64url (32 bytes)
#     VAPID_SUBJECT          mailto: address push services can reach you at
#
#   Redirect URIs to register on the Google client. The Worker builds this from
#   the origin the request arrived on, so every hostname that can serve it needs
#   its own entry — and a published Google client accepts https only, with
#   localhost as the single exception (which is why wrangler.jsonc pins the dev
#   host to localhost rather than letting it inherit the route's reely.space):
#     http://localhost:8788/api/auth/callback     (wrangler dev)
#     https://www.reely.space/api/auth/callback   (production)
#     https://reely.space/api/auth/callback       (apex — also a custom domain)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=        # same value as VAPID_PUBLIC_KEY; the browser needs it to subscribe

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare deploy (CI only — used by deploy:full + waf:apply, not the app)
# ─────────────────────────────────────────────────────────────────────────────
# ONE token does all of it — deploy, waf:apply, dns:harden, cf:health, the deploy
# purge. Scope it to this account + the reely.space zone only, and give it an
# expiry. Permissions (a missing one fails exactly one step, loudly):
#   Account · Workers Scripts Edit · Workers Observability Read · Account Analytics
#            Read · D1 Edit · Account Settings Read
#   Zone   · Zone Read · Zone Settings Edit · DNS Edit · Cache Purge · Zone WAF Edit
#            · Cache Rules Edit · Transform Rules Edit · Workers Routes Edit
#            · Bot Management Edit · Zone Analytics Read
# Account Analytics Read is NOT Zone Analytics Read — cf:health queries both.
CLOUDFLARE_API_TOKEN=                # see the permission list above
CF_ZONE_NAME=                        # zone for waf:apply, e.g. reely.space

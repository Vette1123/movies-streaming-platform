{
  "name": "streaming-movies",
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prettier:format": "prettier --write .",
    "prettier:check": "prettier --check .",
    "imdb:ratings": "node scripts/build-imdb-ratings.mjs",
    "images:check": "node scripts/check-image-fallback.mjs",
    "images:check:live": "node scripts/check-image-fallback.mjs --live",
    "build:worker": "node scripts/build-worker.mjs",
    "build:cf": "node scripts/build-cf.mjs",
    "preview": "pnpm build:cf && wrangler dev",
    "deploy": "node scripts/cf-deploy.mjs",
    "deploy:full": "pnpm build:cf && node scripts/cf-deploy.mjs",
    "fonts:og": "node scripts/build-og-fonts.mjs",
    "icons:build": "node scripts/build-app-icons.mjs",
    "icons:verify": "node scripts/verify-icons.mjs",
    "seo:verify": "node scripts/verify-seo.mjs",
    "og:build": "node scripts/build-og-image.mjs",
    "embed:probe": "node scripts/embed-probe.mjs",
    "d1:migrate": "wrangler d1 migrations apply reely",
    "d1:migrate:remote": "wrangler d1 migrations apply reely --remote",
    "d1:seed": "wrangler d1 execute reely --file db/seed.dev.sql",
    "d1:seed:owner": "wrangler d1 execute reely --file db/seed.owner.sql",
    "d1:seed:owner:remote": "wrangler d1 execute reely --remote --file db/seed.owner.sql",
    "waf:apply": "node scripts/cf-waf-setup.mjs",
    "dns:harden": "node scripts/cf-dns-hardening.mjs",
    "cf:health": "node scripts/cf-health.mjs",
    "cf:cpu": "node scripts/cf-cpu.mjs",
    "bmc:probe": "node scripts/bmc-probe.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.101.4",
    "artplayer": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.43.0",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "nuqs": "^2.9.4",
    "posthog-js": "^1.410.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intersection-observer": "^11.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@posthog/nextjs-config": "^1.9.68",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "husky": "^9.1.7",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}

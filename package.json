{
  "name": "streaming-movies",
  "version": "1.0.0",
  "packageManager": "pnpm@12.14.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prettier:format": "prettier --write .",
    "prettier:check": "prettier --check .",
    "imdb:ratings": "node scripts/build-imdb-ratings.mjs",
    "people:refresh": "node scripts/refresh-people.mjs",
    "ratings:refresh": "node scripts/refresh-media-ratings.mjs",
    "takedown": "node scripts/takedown.mjs",
    "images:check": "node scripts/check-image-fallback.mjs",
    "images:check:live": "node scripts/check-image-fallback.mjs --live",
    "build:worker": "node scripts/build-worker.mjs",
    "build:cf": "node scripts/build-cf.mjs",
    "preview": "pnpm build:cf && wrangler dev",
    "deploy": "node scripts/cf-deploy.mjs",
    "deploy:full": "pnpm build:cf && node scripts/cf-deploy.mjs",
    "fonts:og": "node scripts/build-og-fonts.mjs",
    "icons:build": "node scripts/build-app-icons.mjs",
    "icons:verify": "node scripts/verify-icons.mjs",
    "apps:icons": "node scripts/build-companion-icons.mjs",
    "seo:verify": "node scripts/verify-seo.mjs",
    "og:build": "node scripts/build-og-image.mjs",
    "embed:probe": "node scripts/embed-probe.mjs",
    "d1:migrate": "wrangler d1 migrations apply reely",
    "d1:migrate:remote": "wrangler d1 migrations apply reely --remote",
    "d1:seed": "wrangler d1 execute reely --file db/seed.dev.sql",
    "d1:seed:owner": "wrangler d1 execute reely --file db/seed.owner.sql",
    "d1:seed:owner:remote": "wrangler d1 execute reely --remote --file db/seed.owner.sql",
    "waf:apply": "node scripts/cf-waf-setup.mjs",
    "dns:harden": "node scripts/cf-dns-hardening.mjs",
    "cf:health": "node scripts/cf-health.mjs",
    "cf:cpu": "node scripts/cf-cpu.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "posthog:query": "node scripts/posthog-query.mjs",
    "posthog:issues": "node scripts/posthog-issues.mjs",
    "posthog:usage": "node scripts/posthog-usage.mjs",
    "posthog:setup": "node scripts/posthog-setup.mjs",
    "errors:triage": "node scripts/errors-triage.mjs",
    "bmc:probe": "node scripts/bmc-probe.mjs",
    "search:probe": "node scripts/search-scroll-probe.mjs",
    "vt:probe": "node scripts/view-transition-probe.mjs",
    "resume:probe": "node scripts/resume-probe.mjs",
    "pro": "node scripts/grant-pro.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@tanstack/react-query": "^5.104.5",
    "artplayer": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^14.6.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "nuqs": "^2.10.2",
    "posthog-js": "^1.438.19",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intersection-observer": "^11.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@posthog/nextjs-config": "^1.11.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
